{
  "schema": "kyyow.platform-component.v1",
  "repository": "appolon1908-hue/Codestra-cAdvisor",
  "component": "cadvisor",
  "authority": "container-metrics",
  "exposure": "private",
  "native_ports": [
    8080,
    9443,
    2375
  ],
  "inputs": [
    "container-runtime:read-only",
    "host:cgroups"
  ],
  "outputs": [
    "prometheus:metrics (mTLS GET /metrics through cadvisor-metrics-proxy:9443)"
  ],
  "controls": [
    "cAdvisor 8080 stays on the private cadvisor-metrics network behind the 9443 mTLS proxy",
    "Prometheus scrapes the metrics proxy; Alloy is not a metrics intermediary",
    "Docker API access uses the read-only method/path proxy on the isolated cadvisor-docker-api network at 2375",
    "container labels are allowlisted; no container lifecycle mutation permissions"
  ],
  "identity": {
    "authority": "appolon1908-hue/Keycloak",
    "workload_identity_required": true,
    "anonymous_admin_access": false
  },
  "secrets": {
    "authority": "appolon1908-hue/Codestra-OpenBao",
    "secrets_in_git": false,
    "environment_plaintext_secrets": false
  },
  "operations": {
    "middleware_is_sole_odoo_writer": true,
    "grafana_read_only": true,
    "superset_read_only": true
  },
  "activation": {
    "source_contract_complete": true,
    "runtime_evidence_complete": false,
    "production_activation_authorized": false
  }
}
