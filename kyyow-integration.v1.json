{
  "schema": "kyyow.platform-component.v1",
  "repository": "appolon1908-hue/Codestra-cAdvisor",
  "component": "cadvisor",
  "authority": "container-metrics",
  "exposure": "private",
  "native_ports": [
    8080
  ],
  "inputs": [
    "container-runtime:read-only",
    "host:cgroups"
  ],
  "outputs": [
    "alloy:metrics"
  ],
  "controls": [
    "read-only runtime and host mounts",
    "container labels are allowlisted to avoid secrets and tenant PII",
    "no public listener",
    "no container lifecycle mutation permissions"
  ],
  "identity": {
    "authority": "appolon1908-hue/Keycloak",
    "workload_identity_required": true,
    "anonymous_admin_access": false
  },
  "secrets": {
    "authority": "appolon1908-hue/Codestra-OpenBao",
    "secrets_in_git": false,
    "environment_plaintext_secrets": false
  },
  "operations": {
    "middleware_is_sole_odoo_writer": true,
    "grafana_read_only": true,
    "superset_read_only": true
  },
  "activation": {
    "source_contract_complete": true,
    "runtime_evidence_complete": false,
    "production_activation_authorized": false
  }
}

