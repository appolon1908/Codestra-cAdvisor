#!/usr/bin/env bash
set -euo pipefail
root=$(git rev-parse --show-toplevel)
. "$root/.codestra-mission/ACTIVE-LANE.env"
branch=$(git branch --show-current)
actual_root=$(realpath "$root")
expected_root=$(realpath "$CANONICAL_WORKTREE")
test "$actual_root" = "$expected_root" || { echo "CODESTRA_COMMIT_BLOCKED_WRONG_WORKTREE expected=$expected_root actual=$actual_root"; exit 60; }
test "$branch" = "$ACTIVE_BRANCH" || { echo "CODESTRA_COMMIT_BLOCKED_WRONG_BRANCH expected=$ACTIVE_BRANCH actual=$branch"; exit 61; }
git diff --cached --check
if git diff --cached --name-only | grep -Eq '(^|/)(\.env($|\.)|.*secret.*|.*private.*key.*)$'; then
  echo CODESTRA_COMMIT_BLOCKED_SECRET_LIKE_PATH
  exit 62
fi
echo CODESTRA_PRECOMMIT_PASS
