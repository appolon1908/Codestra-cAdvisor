#!/usr/bin/env bash
set -euo pipefail
root=$(git rev-parse --show-toplevel)
canonical=$(git config --get codestra.canonicalWorktree || true)
test -n "$canonical" || { echo CODESTRA_COMMIT_BLOCKED_CANONICAL_UNSET; exit 59; }
actual_root=$(realpath "$root")
expected_root=$(realpath "$canonical")
test "$actual_root" = "$expected_root" || { echo "CODESTRA_COMMIT_BLOCKED_WRONG_WORKTREE expected=$expected_root actual=$actual_root"; exit 60; }
authority="$canonical/.codestra-mission/ACTIVE-LANE.env"
test -f "$authority" || { echo CODESTRA_COMMIT_BLOCKED_AUTHORITY_MISSING; exit 61; }
. "$authority"
branch=$(git branch --show-current)
test "$branch" = "$ACTIVE_BRANCH" || { echo "CODESTRA_COMMIT_BLOCKED_WRONG_BRANCH expected=$ACTIVE_BRANCH actual=$branch"; exit 62; }
git diff --cached --check
if git diff --cached --name-only | grep -Eq '(^|/)(\.env($|\.)|.*secret.*|.*private.*key.*)$'; then
  echo CODESTRA_COMMIT_BLOCKED_SECRET_LIKE_PATH
  exit 63
fi
echo CODESTRA_PRECOMMIT_PASS
