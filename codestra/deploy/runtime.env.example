# Non-secret Codestra cAdvisor runtime contract.
# Certificate and private-key values are external runtime secrets and never belong here.

CODESTRA_ENVIRONMENT=staging
CODESTRA_REGION=hetzner-eu
CODESTRA_SERVER=replace-with-canonical-server-name
CODESTRA_CADVISOR_DEPLOYMENT_ID=replace-with-immutable-release-id

# Complete immutable image references containing @sha256:...
GO_BUILDER_IMAGE=golang:REPLACE_WITH_PINNED_VERSION@sha256:REPLACE_WITH_REAL_DIGEST
PROXY_RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:REPLACE_WITH_REAL_DIGEST
CADVISOR_BASE_IMAGE=gcr.io/cadvisor/cadvisor:REPLACE_WITH_PINNED_VERSION@sha256:REPLACE_WITH_REAL_DIGEST
CODESTRA_CADVISOR_PROXY_IMAGE=ghcr.io/appolon1908-hue/codestra-cadvisor-proxy:REPLACE_WITH_RELEASE@sha256:REPLACE_WITH_REAL_DIGEST
CODESTRA_CADVISOR_IMAGE=ghcr.io/appolon1908-hue/codestra-cadvisor:REPLACE_WITH_RELEASE@sha256:REPLACE_WITH_REAL_DIGEST

# Resolve from the Docker socket group on the target server. This permits the
# read-only proxy process to connect; the proxy still enforces the HTTP allowlist.
DOCKER_SOCKET_GID=replace-with-numeric-gid

CADVISOR_DOCKER_ROOT_PATH=/var/lib/docker
CADVISOR_DEVICE_METADATA_PATH=/dev/disk
CODESTRA_OBSERVABILITY_NETWORK=codestra-observability

# External secret object names only.
CADVISOR_PROXY_SERVER_CERT_SECRET_NAME=cadvisor-proxy-server-cert
CADVISOR_PROXY_SERVER_KEY_SECRET_NAME=cadvisor-proxy-server-key
PROMETHEUS_CLIENT_CA_SECRET_NAME=prometheus-client-ca
