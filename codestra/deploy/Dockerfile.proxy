# syntax=docker.io/docker/dockerfile@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG GO_BUILDER_IMAGE
ARG PROXY_RUNTIME_IMAGE

FROM ${GO_BUILDER_IMAGE} AS proxy-builder
WORKDIR /src
COPY deploy/proxy.go ./proxy.go
COPY deploy/healthcheck.go ./healthcheck.go
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags='-s -w -buildid=' \
      -o /out/codestra-cadvisor-proxy \
      ./proxy.go \
    && CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags='-s -w -buildid=' \
      -o /out/codestra-healthcheck \
      ./healthcheck.go

FROM ${PROXY_RUNTIME_IMAGE}
LABEL org.opencontainers.image.title="Codestra cAdvisor Security Proxies"
LABEL org.opencontainers.image.description="Read-only Docker metadata proxy and mTLS Prometheus boundary for cAdvisor"
LABEL org.opencontainers.image.vendor="Codestra"

COPY --from=proxy-builder --chown=65532:65532 --chmod=0555 /out/codestra-cadvisor-proxy /codestra-cadvisor-proxy
COPY --from=proxy-builder --chown=65532:65532 --chmod=0555 /out/codestra-healthcheck /codestra-healthcheck

USER 65532:65532
ENTRYPOINT ["/codestra-cadvisor-proxy"]
