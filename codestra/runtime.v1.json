{
  "schemaVersion": "1.0",
  "component": "cadvisor",
  "role": "private-container-resource-metrics-authority",
  "canonicalHostname": "cadv.codestra.media",
  "exposure": "internal_private",
  "status": "CONFIG_PREPARED_NOT_DEPLOYED",
  "businessScope": [
    "platform",
    "codestra",
    "moneybee",
    "beyvra",
    "breero",
    "larim-a",
    "transportation",
    "booked4seasons",
    "social",
    "klyrow",
    "telnexa",
    "kyqra",
    "restaurant",
    "provisioning"
  ],
  "topology": {
    "services": [
      "docker-api-proxy",
      "cadvisor",
      "cadvisor-metrics-proxy"
    ],
    "cadvisorDirectDockerSocket": false,
    "cadvisorOnObservabilityNetwork": false,
    "dockerApiProxyOnObservabilityNetwork": false,
    "metricsProxyOnObservabilityNetwork": true,
    "nativeHostPortsPublished": false,
    "internalDockerApiNetwork": true,
    "internalMetricsNetwork": true
  },
  "dockerApiBoundary": {
    "socketConsumer": "docker-api-proxy-only",
    "client": "cadvisor-only",
    "methods": [
      "GET",
      "HEAD"
    ],
    "allowedResources": [
      "ping",
      "version",
      "info",
      "container_list",
      "container_inspect",
      "container_stats",
      "events",
      "image_inspect",
      "network_list",
      "network_inspect"
    ],
    "containerCreate": false,
    "containerStartStopRestart": false,
    "containerExec": false,
    "containerArchive": false,
    "imageBuildPullPushRemove": false,
    "volumeMutation": false,
    "networkMutation": false,
    "swarmServiceMutation": false,
    "pluginMutation": false,
    "connectionUpgrade": false,
    "requestBodies": false,
    "concurrencyBounded": true,
    "queryKeysBounded": true
  },
  "metricsBoundary": {
    "prometheusEndpoint": "/metrics",
    "healthEndpoint": "/healthz",
    "proxyPort": 9443,
    "tlsMinimumVersion": "TLS13",
    "prometheusClientCertificateRequired": true,
    "otherPathsDenied": true,
    "queryStringsDenied": true,
    "writeMethodsDenied": true,
    "rawCadvisorPortPrivate": true
  },
  "containerIdentity": {
    "storeAllDockerLabels": false,
    "whitelistedDockerLabels": [
      "codestra.business",
      "codestra.application",
      "codestra.service",
      "codestra.environment",
      "codestra.region",
      "codestra.deployment",
      "codestra.replica"
    ],
    "unknownOrIncompleteContainersDroppedByPrometheus": true,
    "containerIdsRetainedAfterRelabel": false,
    "containerNamesRetainedAfterRelabel": false,
    "imageReferencesRetainedAfterRelabel": false,
    "arbitraryDockerLabelsRetainedAfterRelabel": false
  },
  "metricFamilies": {
    "enabled": [
      "cpu",
      "percpu",
      "cpuLoad",
      "memory",
      "disk",
      "diskIO",
      "network",
      "oom_event"
    ],
    "disabled": [
      "advtcp",
      "cpu_topology",
      "cpuset",
      "hugetlb",
      "memory_numa",
      "perf_event",
      "process",
      "referenced_memory",
      "resctrl",
      "sched",
      "tcp",
      "udp"
    ],
    "processMetrics": false,
    "profilingEndpoint": false,
    "eventStorage": false,
    "rootCgroupStats": false
  },
  "hostAccess": {
    "rootFilesystem": "/rootfs:read-only",
    "sysFilesystem": "/sys:read-only",
    "dockerDataRoot": "/var/lib/docker:read-only",
    "deviceMetadata": "/dev/disk:read-only",
    "dockerSocket": "proxy-only:read-only-bind",
    "devKmsg": false,
    "hostNetwork": false,
    "hostPidNamespace": false,
    "privilegedMode": false,
    "cadvisorRunsAsContainerRoot": true,
    "cadvisorLinuxCapabilities": [],
    "reason": "cAdvisor requires broad read-only host and container metadata. It runs as UID 0 only inside a non-privileged, capability-dropped, read-only container; production remains blocked until host-access compatibility and denial tests pass.",
    "hostCgroupNamespace": true
  },
  "authorityBoundaries": {
    "cadvisorOwnsContainerResourceMetrics": true,
    "nodeExporterOwnsHostMetrics": true,
    "opentelemetryOwnsApplicationMetricsAndTraces": true,
    "alloyOwnsContainerAndServiceLogs": true,
    "prometheusOwnsRecordingRulesSloAndAlerts": true,
    "businessMutation": false,
    "containerControlAuthority": false,
    "communicationsDelivery": false,
    "identityAuthority": false,
    "secretsAuthority": false,
    "financialOrTradingMutation": false
  },
  "runtimeHardening": {
    "readOnlyRootFilesystems": true,
    "dropAllCapabilities": true,
    "noNewPrivileges": true,
    "immutableImagesRequired": true,
    "resourceLimitsRequired": true,
    "nativeHealthProbes": true,
    "privateNetworksOnly": true,
    "serverSecretsFromExternalFiles": true
  },
  "financialTradingBoundary": {
    "business": "beyvra",
    "rule": "cAdvisor may expose aggregate container CPU, memory, disk, network, restart and OOM evidence for Beyvra services. It never reads application payloads or credentials, never becomes an authoritative balance/position/execution source and never receives trade mutation authority."
  },
  "activation": {
    "proxyImageBuilt": false,
    "cadvisorImageBuilt": false,
    "immutableDigestsRecorded": false,
    "dockerSocketGidMapped": false,
    "dockerApiAllowlistUnitTestsPassed": false,
    "dockerApiMutationDenialTestsPassed": false,
    "cadvisorLockedSourceFlagsPassed": false,
    "cadvisorStartsWithoutPrivilegedMode": false,
    "cadvisorStartsWithoutHostNetwork": false,
    "cadvisorStartsWithoutHostPid": false,
    "cadvisorStartsWithoutDevKmsg": false,
    "readOnlyHostMountsReviewed": false,
    "requiredContainerLabelsEnforced": false,
    "unknownContainerDropTestPassed": false,
    "metricRelabelCollisionTestPassed": false,
    "metricsProxyServerCertificateIssued": false,
    "prometheusClientCaInstalled": false,
    "mtlsScrapePassed": false,
    "noCertificateScrapeDenied": false,
    "rawCadvisorNetworkDenialPassed": false,
    "crossBusinessAttributionTestPassed": false,
    "cardinalityAndLoadBudgetsPassed": false,
    "prometheusRecordingRulesIntegrated": false,
    "grafanaDashboardsIntegrated": false,
    "productionApproved": false,
    "deploymentEnabled": false
  }
}
